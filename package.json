{
  "name": "sjtu-user-scripts",
  "version": "1.0.0",
  "private": true,
  "description": "Validation and test tooling for SJTU userscripts.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yingyx/sjtu-user-scripts.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
